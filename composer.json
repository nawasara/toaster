{
    "name": "nawasara/toaster",
    "description": "Lightweight, Alpine-based toast notification component for Laravel and Livewire applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nawasara",
        "laravel",
        "livewire",
        "alpine",
        "toast",
        "notification",
        "ui"
    ],
    "authors": [
        {
            "name": "Pringgo J. Saputro",
            "email": "odyinggo@gmail.com",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/nawasara/toaster/issues",
        "source": "https://github.com/nawasara/toaster"
    },
    "autoload": {
        "psr-4": {
            "Nawasara\\Toaster\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nawasara\\Toaster\\ToasterServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
